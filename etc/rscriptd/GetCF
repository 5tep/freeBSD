#!/usr/local/bin/php
<?php

if ($argc < 3) {
    fwrite(STDERR, "Usage: " . $argv[0] . " <login> <cfid>\n");
    exit(1);
}

$login = $argv[1];
$cfid  = $argv[2];

// Подключаем единый файл с подключением к БД
require_once __DIR__ . '/mysql.php';

global $loginDB;

// Подготовленный запрос — безопасен от SQL-инъекций
$stmt = $loginDB->prepare('SELECT `content` FROM `cfitems` WHERE `login` = ? AND `typeid` = ?');
if (!$stmt) {
    fwrite(STDERR, "Prepare failed: " . $loginDB->error . "\n");
    exit(1);
}

$stmt->bind_param('ss', $login, $cfid);
$stmt->execute();
$result = $stmt->get_result();

while ($row = $result->fetch_assoc()) {
    echo $row['content'] . "\n";
}

$stmt->close();
// Подключение $loginDB остаётся активным — это нормально для CLI
