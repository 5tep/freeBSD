#!/bin/sh

# Входящие параметры от Ubilling/Stargazer
LOGIN=$1
IP=$2
ID=$3
CASH=$4

# Настройки интерфейса клиентов (NAS)
# ВАЖНО: Укажите интерфейс, к которому подключены клиенты
CLIENT_IF="em1"

# Получение скоростей (логика осталась прежней)
SPEED=`/etc/rscriptd/GetSpeed $LOGIN`
UPSPEED=`/etc/rscriptd/GetUpSpeed $LOGIN`

# Идентификаторы пайпов (как в старом скрипте)
PIPE_IN=`expr $ID + 101`    # Входящая для юзера (Download)
PIPE_OUT=`expr $ID + 8101`  # Исходящая от юзера (Upload)

# Логирование (дата/время)
cur_date=`date +%Y.%m.%d`
cur_time=`date +%H:%M:%S`

# 1. Настройка пайпов через dnctl (аналог ipfw pipe config)
# FreeBSD 14 использует dnctl для управления dummynet без ipfw правил
# Настраиваем Upload
/sbin/dnctl pipe ${PIPE_OUT} config bw ${UPSPEED}Kbit/s queue 32Kbytes
# Настраиваем Download
/sbin/dnctl pipe ${PIPE_IN} config bw ${SPEED}Kbit/s queue 32Kbytes

# 2. Формирование правила для PF
# Мы используем 'dnpipe (IN, OUT)'. 
# Для входящего на интерфейс трафика (от юзера) -> первый аргумент.
# Для исходящего с интерфейса (к юзеру) -> второй аргумент.
# В PF правило применяется к интерфейсу.
# pass in on $CLIENT_IF from $IP ... dnpipe ($PIPE_OUT, $PIPE_IN)
# Примечание: dnpipe(X, Y) -> X=inbound bandwidth (upload), Y=outbound bandwidth (download)

PFRULE="pass quick on ${CLIENT_IF} inet from ${IP} to any dnpipe (${PIPE_OUT}, ${PIPE_IN})"

# 3. Загрузка правила в персональный якорь пользователя
# Это позволяет удалять/менять правила юзера, не трогая остальных
echo "${PFRULE}" | /sbin/pfctl -a ubilling/${LOGIN} -f -

# 4. (Опционально) Работа с таблицами
# В старом скрипте было удаление из table 47 (блокировка) и добавление в разрешенные.
# В PF можно использовать таблицы для общих списков.
# /sbin/pfctl -t users_active -T add ${IP}
# /sbin/pfctl -t users_blocked -T delete ${IP}

# 5. Day/Night switcher (из старого скрипта)
/bin/echo $SPEED:${PIPE_IN} > /etc/stargazer/dn/$LOGIN
/bin/chmod 777 /etc/stargazer/dn/$LOGIN

# 6. Логирование
echo "$cur_date $cur_time CONNECT: ID-$ID;LOGIN-$LOGIN;IP-$IP;CASH-$CASH;SPEED-$SPEED;UPSPEED-$UPSPEED" >> /var/stargazer/allconnect.log
