#!/bin/sh

# Входящие параметры
LOGIN=$1
IP=$2
ID=$3
CASH=$4

# Пути к утилитам
dncmd="/sbin/dnctl"
pfcmd="/sbin/pfctl"

# Вычисляем номера пайпов (как в OnConnect)
UP_PIPE=`expr $ID + 101`
DOWN_PIPE=`expr $ID + 8101`

# Логирование времени
cur_date=`date +%Y.%m.%d`
cur_time=`date +%H:%M:%S`

echo "Disconnecting user $LOGIN ($IP)..."

# ==========================================================
# 1. Удаление правил фильтрации (PF)
# ==========================================================
# В новой схеме мы создавали персональный якорь для пользователя.
# Нам нужно просто очистить его содержимое. Это удалит правило pass.
${pfcmd} -a ubilling/${LOGIN} -F all 2>/dev/null

# ==========================================================
# 2. Удаление шейпера (Dummynet/dnctl)
# ==========================================================
# Удаляем сами трубы. Правила ipfw искать не нужно, их нет.
${dncmd} pipe delete ${UP_PIPE} 2>/dev/null
${dncmd} pipe delete ${DOWN_PIPE} 2>/dev/null

# ==========================================================
# 3. Управление таблицами PF
# ==========================================================

# Добавляем в список должников/заблокированных (чтобы сработал rdr на заглушку)
${pfcmd} -t block_users -T add $IP 2>/dev/null

# Удаляем из списков активных (если вы их используете для совместимости)
${pfcmd} -t users_in -T delete $IP 2>/dev/null
${pfcmd} -t users_out -T delete $IP 2>/dev/null

# ==========================================================
# 4. Сброс соединений
# ==========================================================
# Убиваем все активные состояния (states) для этого IP, 
# чтобы пользователь не мог докачивать файлы по старым соединениям.
${pfcmd} -k $IP 2>/dev/null    # Kill states by source IP
${pfcmd} -k 0.0.0.0/0 -k $IP 2>/dev/null # Kill states by dest IP

# ==========================================================
# 5. Очистка файлов Ubilling
# ==========================================================
rm -f /etc/stargazer/dn/$LOGIN

# ==========================================================
# 6. Логирование
# ==========================================================
echo "$cur_date $cur_time DISCONNECT: ID-$ID;LOGIN-$LOGIN;IP-$IP;CASH-$CASH" >> /var/stargazer/alldisconnect.log

echo "SUCCESS: User $LOGIN ($IP) disconnected, anchor flushed, pipes deleted."
